REQ {"jsonrpc":"2.0","id":2,"method":"tools/list"}
RESP {"id": 2, "jsonrpc": "2.0", "result": {"tools": [{"description": "Read a blob by key. Returns its bytes verbatim (base64) plus its version_hash, or found=false if the key does not exist. Never follows a URL/path/ref or resolves a pointer to a live secret \u2014 bytes are returned exactly as stored.", "inputSchema": {"additionalProperties": false, "properties": {"key": {"type": "string"}}, "required": ["key"], "type": "object"}, "name": "knokeep_read"}, {"description": "List stored keys matching a prefix.", "inputSchema": {"additionalProperties": false, "properties": {"prefix": {"default": "", "type": "string"}}, "type": "object"}, "name": "knokeep_list"}, {"description": "Write a blob through the secret gate (store.gate.persist) \u2014 never a raw adapter write. Provide exactly one of 'body' (UTF-8 text) or 'body_b64' (base64 bytes). Omit expected_hash (or pass null) for create-only; pass the current version_hash for a compare-and-swap update. Returns the WriteResult (OK/STALE/EXISTS/ERROR, including SECRET_BLOCKED) faithfully, with its commit-class.", "inputSchema": {"additionalProperties": false, "properties": {"body": {"description": "UTF-8 text body", "type": "string"}, "body_b64": {"description": "base64-encoded bytes body", "type": "string"}, "doc_type": {"description": "One of the STATE allowlist (system_state, session_log, HANDOFF, journal) for content-hash CAS, or any other type whose body carries a '#knokeep-gen:<uint64>\\n' generation header.", "type": "string"}, "expected_hash": {"description": "64-hex sha256; null/omitted means create-only", "type": ["string", "null"]}, "key": {"type": "string"}}, "required": ["key", "doc_type"], "type": "object"}, "name": "knokeep_write"}, {"description": "Run the read-only reconciler over the store plus any supplied external facts (github_head/tracker_status) and return a drift report. Every fetched value is secret-scanned and quarantined before it can appear in the report.", "inputSchema": {"additionalProperties": false, "properties": {"fact_specs": {"description": "Optional custom fact specs; defaults to DEFAULT_FACT_SPECS.", "items": {"properties": {"fact_key": {"type": "string"}, "fields": {"additionalProperties": {"type": "string"}, "type": "object"}, "source_of_truth": {"type": "string"}}, "required": ["fact_key", "fields", "source_of_truth"], "type": "object"}, "type": "array"}, "github_head": {"type": ["string", "null"]}, "keys": {"description": "Store keys to read as the 'store' source.", "items": {"type": "string"}, "type": "array"}, "tracker_status": {"type": ["string", "null"]}}, "type": "object"}, "name": "knokeep_reconcile"}, {"description": "Cheap backend health/verdict summary.", "inputSchema": {"additionalProperties": false, "properties": {}, "type": "object"}, "name": "knokeep_health"}]}}
